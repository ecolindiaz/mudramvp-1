# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# test output
.test-output/

# dependencies
/node_modules
node_modules.partial_install*
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated files and database
/lib/generated/prisma
*.db
*.db-journal

# uploads
/public/uploads/avatars/*
!/public/uploads/avatars/.gitkeep
