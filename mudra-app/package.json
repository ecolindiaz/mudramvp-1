{
  "name": "mudra-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "pkill -f 'next dev' || true && rm -rf .next && npm run dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "mastra:dev": "mastra dev --dir ./mastra",
    "mastra:build": "mastra build --dir ./mastra",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && next build",
    "lint": "next lint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:scoring": "tsx lib/tests/technical-scoring.test.ts",
    "test:load": "node lib/tests/load-test-scraper.js",
    "test:all": "npm run test:scoring && npm run test:load",
    "enhanced-geo": "tsx lib/scrapers/enhanced-geo-scraper.ts",
    "geo": "tsx lib/scrapers/geo-technical-scraper.ts",
    "extract": "tsx lib/scrapers/schema-extractor.ts",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build",
    "docker:down": "docker-compose -f docker-compose.dev.yml down",
    "docker:logs": "docker-compose -f docker-compose.dev.yml logs -f app",
    "docker:db": "docker-compose -f docker-compose.dev.yml exec db psql -U postgres -d mudra",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio"
  },
