// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-arm64-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model BrandProfile {
  id                Int      @id @default(autoincrement())
  userId            String?  // Link to User model
  companyName       String?  
  companyWebsite    String?  
  companyLinkedIn   String?  
  companyTwitter    String?  
  userName          String?  
  userRole          String?
  userAvatar        String?
  companyDescription String? 
  companyIndustry   String?  
  companyServices   String?  
  companyICP        String?  
  competitors       String?  // Store as comma-separated string or use a relation for advanced use
  monthlySearchVolume String?
  aiRecommendations String?  
  stage             String?  
  resources         String?  // Store as JSON string if needed
  lastAnalysisRunAt DateTime?  // Track when analysis was last run
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  prompts           Prompt[]
  analysisRuns      AnalysisRun[]
  technicalStructureAnalyses TechnicalStructureAnalysis[]
  geoAnalysisResults         GeoAnalysisResult[]
  organicTrafficMetrics      OrganicTrafficMetrics[]
  naturalLanguageReports     NaturalLanguageReport[]
  aiReferralVisits           AIReferralVisit[]
  aiReferralAnalytics        AIReferralAnalytics[]
  deployedAgents             DeployedAgent[]
  
  @@index([userId])
}

// Prompt Management Models
model Prompt {
  id              Int      @id @default(autoincrement())
  brandProfileId  Int
  text            String   @db.Text
  category        String?  // e.g., "product", "service", "comparison"
  isCustom        Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  brandProfile    BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  
  @@map("prompts")
  @@index([brandProfileId])
  @@index([brandProfileId, isActive])
}

model AnalysisRun {
  id              Int      @id @default(autoincrement())
  brandProfileId  Int
  promptsUsed     Json     // Array of prompt IDs used
  results         Json     // Store the full analysis results
  overallScore    Float    @default(0)
  status          String   @default("pending") // pending, running, completed, failed
  ranAt           DateTime @default(now())
  completedAt     DateTime?
  
  // Relations
  brandProfile    BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  
  @@map("analysis_runs")
  @@index([brandProfileId])
  @@index([brandProfileId, ranAt])
  @@index([status])
}

// Enums for type safety
enum RecommendationSeverity {
  HIGH
  MEDIUM
  LOW
}

enum RecommendationImpact {
  SEO
  PERFORMANCE
  ACCESSIBILITY
  USER_EXPERIENCE
}

enum RecommendationCategory {
  STRUCTURED_DATA
  CONTENT_AUTHORITY
  TECHNICAL_ACCESSIBILITY
  FAQ_OPTIMIZATION
  CONTENT_FRESHNESS
  ENTITY_RECOGNITION
}

// User's Website Management
model Website {
  id          String @id @default(cuid())
  userId      String
  url         String
  domain      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  technicalAnalyses TechnicalAnalysis[]
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("websites")
  @@unique([userId, url]) // One analysis per URL per user
  @@index([userId])
  @@index([domain])
}

// Core Technical Structure Analysis
model TechnicalAnalysis {
  id                    String   @id @default(cuid())
  websiteId             String
  sourceUrl             String   // Match EnhancedGEOResult.url field
  timestamp             DateTime @default(now()) // Match interface field name
  
  // GEO Scores
  overallScore          Float    @default(0)
  contentAuthority      Float    @default(0)
  technicalAccessibility Float   @default(0)
  structuredData        Float    @default(0)
  entityRecognition     Float    @default(0)
  faqOptimization       Float    @default(0)
  contentFreshness      Float    @default(0)
  
  // Metadata
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // Relations
  website               Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  structuredDataAnalysis StructuredData?
  entityRecognitionAnalysis EntityRecognition?
  faqAnalysis          FAQAnalysis?
  contentFreshnessAnalysis ContentFreshness?
  contentStructure     ContentStructure?
  technicalAccessibilityAnalysis TechnicalAccessibility?
  recommendations      AnalysisRecommendation[]
  
  @@map("technical_analyses")
  @@index([websiteId])
  @@index([timestamp])
  @@index([websiteId, timestamp]) // For time-series queries per website
  @@index([websiteId, overallScore]) // For ranking websites by score
  @@index([timestamp, overallScore]) // For trending analysis
}

// Structured Data Detection
model StructuredData {
  id                    String            @id @default(cuid())
  technicalAnalysisId   String            @unique
  technicalAnalysis     TechnicalAnalysis @relation(fields: [technicalAnalysisId], references: [id], onDelete: Cascade)
  
  // Raw Structured Data (matching your algorithm exactly)
  jsonLdData            Json              // Store the jsonLd array
  microdataData         Json              // Store the microdata array  
  rdfaData              Json              // Store the rdfa array
  schemaTypes           Json              // Store the schemaTypes string array
  faqSchemas            Json              // Store the faqSchemas array
  
  // Specific Schema Objects (optional, matching your algorithm)
  organizationSchema    Json?             // Store the organizationSchema object
  websiteSchema         Json?             // Store the websiteSchema object
  breadcrumbSchema      Json?             // Store the breadcrumbSchema object
  
  // Derived Boolean Flags (for quick querying)
  hasOrganizationSchema Boolean           @default(false)
  hasWebsiteSchema      Boolean           @default(false)
  hasBreadcrumbSchema   Boolean           @default(false)
  hasFAQSchema          Boolean           @default(false)
  
  createdAt             DateTime          @default(now())
  
  @@map("structured_data")
  @@index([hasOrganizationSchema])
  @@index([hasFAQSchema])
}

// Entity Recognition and Knowledge Graph
model EntityRecognition {
  id                   String            @id @default(cuid())
  technicalAnalysisId  String            @unique //
  technicalAnalysis    TechnicalAnalysis @relation(fields: [technicalAnalysisId], references: [id], onDelete: Cascade)
  
  // Entity Data (JSON Arrays - matching your algorithm exactly)
  organizations        Json              // string[] - Organizations found
  people              Json              // string[] - People found  
  technologies        Json              // string[] - Technologies mentioned
  products            Json              // string[] - Products/services
  locations           Json              // string[] - Geographic locations
  
  // Entity Counts (derived for quick querying)
  organizationsCount   Int               @default(0)
  peopleCount         Int               @default(0)
  technologiesCount   Int               @default(0)
  productsCount       Int               @default(0)
  locationsCount      Int               @default(0)
  
  createdAt           DateTime          @default(now())
  
  @@map("entity_recognition")
  @@index([organizationsCount])
  @@index([technologiesCount])
}

// FAQ Optimization Analysis
model FAQAnalysis {
  id                    String            @id @default(cuid())
  technicalAnalysisId   String            @unique // Should be unique for 1:1 relationship
  technicalAnalysis     TechnicalAnalysis @relation(fields: [technicalAnalysisId], references: [id], onDelete: Cascade)
  
  // Direct mapping to your algorithm fields
  questionAnswerPairs   Int               @default(0) // Matches your algorithm exactly
  faqStructuredData     Boolean           @default(false) // Renamed to match algorithm
  faqSchemaPresent      Boolean           @default(false) // Matches your algorithm exactly
  
  // FAQ content storage
  faqSections           Json              // Store the faqSections array (removed ?)
  
  // Derived count for quick querying
  faqSectionCount       Int               @default(0) // Derived from faqSections.length
  
  createdAt             DateTime          @default(now())
  
  @@map("faq_analyses")
  @@index([questionAnswerPairs])
  @@index([faqSchemaPresent])
}

//ContentFreshness
model ContentFreshness {
  id                   String            @id @default(cuid())
  technicalAnalysisId  String            @unique
  technicalAnalysis    TechnicalAnalysis @relation(fields: [technicalAnalysisId], references: [id], onDelete: Cascade)
  
  // Freshness Data (matching your algorithm exactly)
  publishDate          String?           // Your algo uses string, not DateTime
  lastModified         String?           // Your algo uses string, not DateTime
  updateFrequency      String?
  freshnessSignals     Json              // Store the freshnessSignals array
  
  // Derived count for quick querying
  freshnessSignalsCount Int              @default(0)
  
  createdAt            DateTime          @default(now())
  
  @@map("content_freshness")
}

// Content Structure and Quality
model ContentStructure {
  id                   String            @id @default(cuid())
  technicalAnalysisId  String            @unique
  technicalAnalysis    TechnicalAnalysis @relation(fields: [technicalAnalysisId], references: [id], onDelete: Cascade)
  
  // Headings Hierarchy (store actual content + counts)
  headingsHierarchy    Json              // Store the complete hierarchy object
  h1Count              Int               @default(0)
  h2Count              Int               @default(0)
  h3Count              Int               @default(0)
  h4Count              Int               @default(0)
  h5Count              Int               @default(0)
  h6Count              Int               @default(0)
  
  // Authority Signals (store actual content + counts)
  authoritySignals     Json              // Store the complete authority signals object
  statisticsCount      Int               @default(0)
  expertQuotesCount    Int               @default(0)
  citationsCount       Int               @default(0)
  testimonialsCount    Int               @default(0)
  
  // Content Quality (matching your algorithm exactly)
  wordCount            Int?
  paragraphCount       Int?
  listCount            Int?
  tableCount           Int?
  imageCount           Int?
  readingLevel         String?
  
  createdAt            DateTime          @default(now())
  
  @@map("content_structures")
  @@index([wordCount])
}

// Technical Accessibility and Performance
model TechnicalAccessibility {
  id                    String            @id @default(cuid())
  technicalAnalysisId   String            @unique
  technicalAnalysis     TechnicalAnalysis @relation(fields: [technicalAnalysisId], references: [id], onDelete: Cascade)
  
  // Meta Tags (store actual data + presence flags)
  metaTags              Json              // Store complete metaTags object
  hasTitle              Boolean           @default(false)
  hasDescription        Boolean           @default(false)
  hasCanonical          Boolean           @default(false)
  hasRobots             Boolean           @default(false)
  hreflangCount         Int               @default(0)
  
  // Open Graph & Twitter Cards (store actual data)
  openGraphData         Json              // Store openGraph Record<string, string>
  twitterCardData       Json              // Store twitterCard Record<string, string> 
  hasOgTitle            Boolean           @default(false)
  hasOgDescription      Boolean           @default(false)
  hasOgImage            Boolean           @default(false)
  hasTwitterCard        Boolean           @default(false)
  
  // Technical Elements (matching your algorithm exactly)
  technicalElements     Json              // Store complete technicalElements object
  httpsStatus           Boolean           @default(false)
  statusCode            Int?
  contentType           String?
  responseTime          Float?            // Your algo uses number (Float)
  mobileFriendly        Boolean?
  internalLinksCount    Int               @default(0)
  
  // Core Web Vitals (matching your algorithm field names exactly)
  lcp                   Float?            // Largest Contentful Paint
  fid                   Float?            // First Input Delay  
  cls                   Float?            // Cumulative Layout Shift
  
  // Accessibility (store actual data + counts)
  accessibilityData     Json              // Store complete accessibility object
  altTextCount          Int               @default(0)
  ariaLabelsCount       Int               @default(0)
  semanticElementsCount Int               @default(0)
  skipLinks             Boolean           @default(false)
  headingStructureValid Boolean           @default(false)
  landmarkRolesCount    Int               @default(0)
  
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  
  @@map("technical_accessibility")
  @@index([httpsStatus])
  @@index([statusCode])
  @@index([mobileFriendly])
}

// Analysis Recommendations and Action Items
model AnalysisRecommendation {
  id                    String @id @default(cuid())
  technicalAnalysisId   String
  
  category              RecommendationCategory
  severity              RecommendationSeverity
  title                 String
  description           String
  actionRequired        String
  impact                RecommendationImpact
  isCompleted           Boolean @default(false)
  
  createdAt             DateTime @default(now())
  
  technicalAnalysis     TechnicalAnalysis @relation(fields: [technicalAnalysisId], references: [id], onDelete: Cascade)
  
  @@map("analysis_recommendations")
  @@index([technicalAnalysisId])
  @@index([severity])
  @@index([isCompleted])
  @@index([category, severity]) // Composite index for filtering
  @@index([technicalAnalysisId, isCompleted]) // For showing pending tasks
}

// User model (add this relation to your existing User model)
model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String?
  password            String?   // For credentials login
  emailVerified       DateTime? // Email verification timestamp
  image               String?   // Profile image (for OAuth)
  verificationToken   String?   // For email verification
  resetToken          String?   // For password reset
  resetTokenExpiry    DateTime? // Password reset token expiration
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  // Relations
  websites            Website[]
  brandProfiles       BrandProfile[]
  accounts            Account[]
  sessions            Session[]
  githubIntegration   GitHubIntegration?
  
  @@map("users")
}

// NextAuth adapter tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================
// Task Feature: Persistence v1
// ============================

model Company {
  id        String  @id @default(cuid())
  domain    String  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sites     Site[]
  weeklyReports WeeklyReport[]

  @@map("companies")
}

model Site {
  id          String   @id @default(cuid())
  companyId   String
  url         String
  domain      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  snapshots   CrawlSnapshot[]
  tasks       Task[]

  @@map("sites")
  @@index([companyId])
  @@index([domain])
}

model CrawlSnapshot {
  id        String   @id @default(cuid())
  siteId    String
  crawledAt DateTime @default(now())
  data      Json

  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  score     TechnicalScore?
  verifications TaskVerification[]

  @@map("crawl_snapshots")
  @@index([siteId, crawledAt])
}

model TechnicalScore {
  id          String        @id @default(cuid())
  snapshotId  String        @unique
  total       Int
  components  Json
  createdAt   DateTime      @default(now())

  snapshot    CrawlSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@map("technical_scores")
}

model Task {
  id             String   @id @default(cuid())
  siteId         String
  templateKey    String
  title          String
  whyItMatters   String
  impact         String
  steps          Json
  tags           Json
  evidence       Json
  suggestedOwner String?
  confidence     Float
  status         String   @default("open") // open, done, verified, dismissed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  site           Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  verifications  TaskVerification[]

  @@map("tasks")
  @@index([siteId, status])
  @@index([templateKey])
}

model TaskVerification {
  id          String        @id @default(cuid())
  taskId      String
  snapshotId  String
  passed      Boolean
  createdAt   DateTime      @default(now())

  task        Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  snapshot    CrawlSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@map("task_verifications")
  @@index([taskId, createdAt])
  @@index([snapshotId])
}

// ============================
// Natural Language Report
// ============================

model WeeklyReport {
  id              String    @id @default(cuid())
  companyId       String    @map("org_id")
  weekStartUtc    DateTime  @map("week_start_utc")
  status          String
  model           String?
  summaryMarkdown String?   @map("summary_markdown")
  summaryJson     Json?     @map("summary_json")
  tokensIn        Int?      @map("tokens_in")
  tokensOut       Int?      @map("tokens_out")
  costCents       Int?      @map("cost_cents")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt      @map("updated_at")

  // Relations
  company  Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sections WeeklyReportSection[]

  @@map("weekly_reports")
  @@unique([companyId, weekStartUtc])
  @@index([companyId])
  @@index([weekStartUtc])
}

model WeeklyReportSection {
  id            String   @id @default(cuid())
  reportId      String   @map("report_id")
  key           String
  title         String?
  order         Int      @default(0)
  bodyMarkdown  String?  @map("body_markdown")
  bodyJson      Json?    @map("body_json")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  // Relations
  report  WeeklyReport           @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sources WeeklyReportSourceRef[]

  @@map("weekly_report_sections")
  @@index([reportId])
  @@index([key])
}

model WeeklyReportSourceRef {
  id         String   @id @default(cuid())
  sectionId  String   @map("section_id")
  sourceType String   @map("source_type")
  refTable   String?  @map("ref_table")
  refId      String?  @map("ref_id")
  url        String?
  label      String?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  section WeeklyReportSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("weekly_report_source_refs")
  @@index([sectionId])
  @@index([sourceType])
}

// Analysis Pipeline Results Models
model TechnicalStructureAnalysis {
  id                Int      @id @default(autoincrement())
  brandProfileId    Int
  websiteUrl        String
  overallScore      Float    @default(0)
  performanceScore  Float?
  seoScore          Float?
  accessibilityScore Float?
  securityScore     Float?
  structureScore    Float?
  insights          Json     @default("[]")
  recommendations   Json     @default("[]")
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  brandProfile      BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  
  @@index([brandProfileId])
  @@index([brandProfileId, createdAt])
}

model GeoAnalysisResult {
  id              Int      @id @default(autoincrement())
  brandProfileId  Int
  overallScore    Float    @default(0)
  analyses        Json     @default("[]")
  summary         Json     @default("{}")
  timestamp       DateTime @default(now())
  createdAt       DateTime @default(now())
  
  // Relations
  brandProfile    BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  
  @@index([brandProfileId])
  @@index([brandProfileId, timestamp])
}

model OrganicTrafficMetrics {
  id                    Int      @id @default(autoincrement())
  brandProfileId        Int
  monthlyVisitors       Int      @default(0)
  monthOverMonthGrowth  Float    @default(0)
  topPages              Json     @default("[]")
  topKeywords           Json     @default("[]")
  metadata              Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // Relations
  brandProfile          BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  
  @@index([brandProfileId])
}

model NaturalLanguageReport {
  id              Int      @id @default(autoincrement())
  brandProfileId  Int
  reportText      String   @db.Text
  insights        Json     @default("[]")
  recommendations Json     @default("[]")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  brandProfile    BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  
  @@index([brandProfileId])
  @@index([brandProfileId, createdAt])
}

// AI Referral Traffic Tracking
model AIReferralVisit {
  id              Int      @id @default(autoincrement())
  brandProfileId  Int
  siteId          String   // Unique tracking ID per site
  referrer        String   // Full referrer URL (e.g., "https://chatgpt.com")
  aiProvider      String   // Normalized: chatgpt, perplexity, claude, gemini
  path            String   // Path visited (e.g., "/blog/article")
  userAgent       String?  // Browser user agent
  ipAddress       String?  // IP address (hashed for privacy)
  sessionId       String?  // Session identifier
  metadata        Json     @default("{}") // Additional tracking data
  timestamp       DateTime @default(now())
  createdAt       DateTime @default(now())
  
  // Relations
  brandProfile    BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  
  @@index([brandProfileId])
  @@index([siteId])
  @@index([brandProfileId, timestamp])
  @@index([brandProfileId, aiProvider, timestamp])
  @@index([aiProvider])
}

model AIReferralAnalytics {
  id                    Int      @id @default(autoincrement())
  brandProfileId        Int
  totalVisits           Int      @default(0)
  chatgptVisits         Int      @default(0)
  perplexityVisits      Int      @default(0)
  claudeVisits          Int      @default(0)
  geminiVisits          Int      @default(0)
  topPages              Json     @default("[]") // [{path: string, visits: number}]
  periodStart           DateTime
  periodEnd             DateTime
  metadata              Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // Relations
  brandProfile          BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  
  @@index([brandProfileId])
  @@index([brandProfileId, periodStart])
}

// Agent Deployment and Execution Models
model DeployedAgent {
  id                Int      @id @default(autoincrement())
  brandProfileId    Int
  agentType         String   // "aeo-geo-optimizer", "growth-scout", etc.
  agentName         String
  agentDescription  String?
  status            String   @default("deploying") // deploying, active, paused, failed
  githubRepoId      String?  // Connected GitHub repository ID
  githubRepoName    String?  // e.g., "EmiCorleone/mudramvp"
  githubBranch      String   @default("main")
  lastExecutedAt    DateTime?
  deployedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  brandProfile      BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  tasks             AgentTask[]
  optimizations     AgentOptimization[]
  
  @@index([brandProfileId])
  @@index([brandProfileId, status])
  @@index([status])
}

model AgentTask {
  id                Int      @id @default(autoincrement())
  deployedAgentId   Int
  taskType          String   // "analyze", "optimize", "generate_schema", "create_pr"
  taskName          String
  status            String   @default("pending") // pending, running, completed, failed
  input             Json     // Task input parameters
  output            Json?    // Task results
  errorMessage      String?  @db.Text
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime @default(now())
  
  // Relations
  deployedAgent     DeployedAgent @relation(fields: [deployedAgentId], references: [id], onDelete: Cascade)
  
  @@index([deployedAgentId])
  @@index([deployedAgentId, status])
  @@index([status])
}

model AgentOptimization {
  id                Int      @id @default(autoincrement())
  deployedAgentId   Int
  optimizationType  String   // "schema_markup", "faq_section", "headers", "meta", etc.
  filePath          String?  // File that was modified
  description       String   @db.Text
  beforeCode        String?  @db.Text
  afterCode         String?  @db.Text
  impact            String   // "high", "medium", "low"
  status            String   @default("pending") // pending, applied, pr_created, merged, failed
  pullRequestUrl    String?
  appliedAt         DateTime?
  createdAt         DateTime @default(now())
  
  // Relations
  deployedAgent     DeployedAgent @relation(fields: [deployedAgentId], references: [id], onDelete: Cascade)
  
  @@index([deployedAgentId])
  @@index([deployedAgentId, status])
}

model GitHubIntegration {
  id                Int      @id @default(autoincrement())
  userId            String
  accessToken       String   @db.Text // Encrypted GitHub PAT
  refreshToken      String?  @db.Text
  tokenExpiresAt    DateTime?
  githubUserId      String
  githubUsername    String
  avatarUrl         String?
  scope             String?  // OAuth scopes granted
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId])
  @@index([userId])
  @@index([githubUserId])
}
