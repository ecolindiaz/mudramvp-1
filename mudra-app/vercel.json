{
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "crons": [
    {
      "path": "/api/cron/weekly-analysis",
      "schedule": "0 2 * * 0"
    },
    {
      "path": "/api/cron/weekly",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/cron/weekly-nlr",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/conversation-radar/cron",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/llms-txt-refresh",
      "schedule": "0 3 28 * *"
    }
  ],
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 60
    },
    "app/api/issues/**/*.ts": {
      "maxDuration": 300
    },
    "app/api/analysis/**/*.ts": {
      "maxDuration": 540,
      "memory": 1024
    },
    "app/api/content-lab/**/*.ts": {
      "maxDuration": 300
    },
    "app/api/cron/**/*.ts": {
      "maxDuration": 540
    },
    "app/api/conversation-radar/cron/**/*.ts": {
      "maxDuration": 540
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,DELETE,PATCH,POST,PUT"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version"
        }
      ]
    }
  ]
}
